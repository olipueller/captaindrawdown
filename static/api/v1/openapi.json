{"openapi":"3.0.3","info":{"title":"Captain Drawdown CDR Data API","version":"2026-11.4","description":"Read-only JSON files served statically (no keys, no rate limit beyond the host). Every response carries version, as_of, license and cite_as. Companies: CC BY-NC-SA 4.0; researchers and shops: CC BY 4.0. Corrections: info@carbon-drawdown.de.","contact":{"email":"info@carbon-drawdown.de","url":"https://captaindrawdown.com/data/"},"license":{"name":"see per-dataset licence","url":"https://captaindrawdown.com/data/"}},"servers":[{"url":"https://captaindrawdown.com"}],"paths":{"/api/v1/index.json":{"get":{"summary":"API root: endpoints, version, licences, citation","responses":{"200":{"description":"OK"}}}},"/api/v1/stats.json":{"get":{"summary":"Headline numbers of the newest release","responses":{"200":{"description":"OK"}}}},"/api/v1/companies.json":{"get":{"summary":"All published carbon removal companies","responses":{"200":{"description":"Array of company objects in `data`"}}}},"/api/v1/companies/{slug}.json":{"get":{"summary":"One company by slug","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Company object"},"404":{"description":"Unknown slug"}}}},"/api/v1/countries.json":{"get":{"summary":"Published companies per country (ISO 3166-1 alpha-2)","responses":{"200":{"description":"OK"}}}},"/api/v1/pathways.json":{"get":{"summary":"Published companies per primary pathway","responses":{"200":{"description":"OK"}}}},"/api/v1/researchers/by-country.json":{"get":{"summary":"Listed CDR researchers per country, with calibrated estimate","responses":{"200":{"description":"OK"}}}},"/api/v1/researchers/by-pathway.json":{"get":{"summary":"Listed CDR researchers per primary pathway","responses":{"200":{"description":"OK"}}}},"/api/v1/researchers/top/{pathway}.json":{"get":{"summary":"Top researchers per pathway: most active (global_top100, europe_top50) and most cited (cited_top100, cited_europe_top50)","parameters":[{"name":"pathway","in":"path","required":true,"schema":{"type":"string","enum":["dac","beccs","enhanced-weathering","ocean-cdr","biochar","cross-cutting-cdr"]}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/shops.json":{"get":{"summary":"Shops selling certified carbon removal to individuals, with prices","responses":{"200":{"description":"OK"}}}}}}